<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>LiteDB.Vector</AssemblyName>
    <RootNamespace>LiteDB.Vector</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>LiteDB.Vector</PackageId>
    <Description>Vector search plugin for LiteDB - HNSW-based nearest neighbor search</Description>
    <PackageTags>litedb;vector;embedding;search;hnsw;nosql</PackageTags>
    <Authors>Mauricio David</Authors>
    <Company>LiteDB</Company>
    <Copyright>MIT</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteDB\LiteDB.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

</Project>
